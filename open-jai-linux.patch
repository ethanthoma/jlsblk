-    while (offset < len) {
-        const read_count = oj_rt_read(fd, data + offset, len - offset);
-        if (read_count <= 0) {
+    // Loop until EOF instead of trusting stat() size, so 0-size virtual files
+    // (procfs/sysfs) read correctly rather than coming back empty.
+    var cap: usize = 4096;
+    var data_raw = rtAlloc(cap) orelse return null;
+    var len: usize = 0;
+    while (true) {
+        if (len == cap) {
+            const new_cap = cap * 2;
+            const grown = rtRealloc(data_raw, cap, new_cap) orelse {
+                rtFree(data_raw);
+                return null;
+            };
+            data_raw = grown;
+            cap = new_cap;
+        }
+        const data: [*]u8 = @ptrCast(data_raw);
+        const read_count = oj_rt_read(fd, data + len, cap - len);
+        if (read_count < 0) {
             rtFree(data_raw);
-            rtFree(header_raw);
             return null;
         }
-        offset += @intCast(read_count);
+        if (read_count == 0) break;
+        len += @intCast(read_count);
     }
+
+    const header_raw = rtAlloc(@sizeOf(OpenJaiRuntimeString)) orelse {
+        rtFree(data_raw);
+        return null;
+    };
     const header: *OpenJaiRuntimeString = @ptrCast(@alignCast(header_raw));
-    header.* = .{ .len = len, .data = data };
+    header.* = .{ .len = len, .data = @ptrCast(data_raw) };
     return header;
 }
 
